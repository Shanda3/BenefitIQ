{
  // Pilot Worker. It routes every request to one container. Secrets are not listed here.
  "name": "benefitiq",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "benefitiq.devyo.app",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "BenefitIQ",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BENEFITIQ",
        "class_name": "BenefitIQ"
      }
    ]
  },
  "exports": {
    "BenefitIQ": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
